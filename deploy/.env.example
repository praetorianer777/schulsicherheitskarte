# Copy to deploy/.env and adjust. docker compose reads this file automatically.

# Change this before the stack is reachable by anyone but you. The database is
# not published to the host, but a default password stays a default password.
POSTGRES_PASSWORD=ssk

POSTGRES_USER=ssk
POSTGRES_DB=ssk

# Which published images to run. "main" is the current state of the default
# branch. To pin an installation to an exact commit, use sha-<kurzer Hash> —
# then an update is a deliberate change of this value, not whatever was pushed
# in the meantime.
IMAGE_TAG=main

# Host port the API listens on. 8080 is a common collision; pick a free one.
API_PORT=8080

# Which interface the API is published on. The default reaches every network
# the machine is on. Behind a reverse proxy on another machine, set this to the
# address that machine reaches — then the API cannot be called around the proxy.
# With the proxy on the same machine, 127.0.0.1 is the right answer.
API_BIND=0.0.0.0

# Set to true only when a reverse proxy sits in front and is the only way in.
# It makes the API believe the X-Forwarded-For header, which is what shows the
# real client instead of the proxy — and what anyone can forge if the API port
# is reachable directly.
TRUST_PROXY_HEADERS=false
